{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "ts-node src/index.ts",
    "dev": "nodemon src/index.ts",
    "debug": "nodemon --watch . --ext ts,json,js,mjs,cjs --exec \"node --inspect -r ts-node/register src/index.ts\"",
    "build": "npx tsc && node -e \"const fs=require('fs'),p='dist/public';if(!fs.existsSync(p))fs.mkdirSync(p,{recursive:true});fs.copyFileSync('public/swagger.json','dist/public/swagger.json');console.log('Swagger copied ✔')\"",
    "mkr": "npx tsoa routes && npx prettier@2.8.1 src/routes/routes.ts -w",
    "_mks": "tsoa spec && npx prettier@2.8.1 public/swagger.json -w",
    "_mkp": "npx prisma format && npx prisma generate",
    "migrate": "npx prisma generate && npx prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14",
    "npm": "^11.13.0",
    "prisma": "^7.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsoa": "^7.0.0-alpha.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "prettier": "^3.8.3",
    "tsconfig-paths": "^4.2.0"
  }
}
